# Frontend Environment Variables (placeholders only)

# Server-only backend URL used by Next.js BFF routes (NOT exposed to the browser)
BACKEND_API_URL=http://localhost:5000

# Optional legacy alias — prefer BACKEND_API_URL. Do not rely on NEXT_PUBLIC for server calls.
# NEXT_PUBLIC_API_BASE_URL is intentionally omitted to avoid leaking the backend origin.

# HMAC secret for legacy signed public feedback links (must match backend LINK_SECRET)
LINK_SECRET=replace_with_long_random_link_signing_secret_at_least_32
