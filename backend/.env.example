# Backend Environment Variables (placeholders only — never commit real secrets)

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://feedback:feedback@localhost:5432/feedback_desk

# Required secrets (min 16 chars in development, 32+ in production)
JWT_SECRET=replace_with_long_random_jwt_secret_at_least_32_chars
OTP_HMAC_SECRET=replace_with_long_random_otp_hmac_secret_at_least_32
LINK_SECRET=replace_with_long_random_link_signing_secret_at_least_32

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Optional / providers
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Feedback Desk <noreply@example.com>

# Development: print OTP to the backend terminal instead of sending email (default on when NODE_ENV!=production).
# Set to false if you want real Resend emails while developing.
# DEV_OTP_TO_CONSOLE=false

# Worker (in-process with the API — how many AI analysis jobs run in parallel)
WORKER_CONCURRENCY=2

# Seconds before a crashed worker's processing lock is treated as abandoned (default 1800 = 30m)
# JOB_LOCK_TIMEOUT_SECONDS=1800
